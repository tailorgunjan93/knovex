{
  "name": "knovex-desktop",
  "version": "0.12.0",
  "description": "Knovex Desktop — Electron shell",
  "homepage": "https://tailorgunjan93.github.io/knovex/",
  "author": {
    "name": "Gunjan Tailor",
    "email": "tailorgunjan89@gmail.com"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.knovex.app",
    "productName": "Knovex",
    "copyright": "Copyright © 2026 Gunjan Tailor",

    "directories": {
      "buildResources": "assets",
      "output": "release"
    },

    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],

    "extraResources": [
      {
        "from": "../backend/dist/knovex-backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      }
    ],

    "publish": {
      "provider": "github",
      "owner": "tailorgunjan93",
      "repo": "knovex",
      "releaseType": "release"
    },

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Knovex-Setup-${version}.exe",
      "verifyUpdateCodeSignature": false
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Knovex",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "Knovex",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "assets/installer.nsh"
    },

    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Knovex-${version}.dmg",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },

    "dmg": {
      "title": "Knovex ${version}",
      "iconSize": 100
    },

    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "description": "Your AI-powered knowledge assistant",
      "desktop": {
        "Name": "Knovex",
        "Comment": "AI-powered knowledge assistant",
        "Categories": "Office;Utility;"
      }
    },

    "appImage": {
      "artifactName": "Knovex-${version}.AppImage"
    },

    "deb": {
      "artifactName": "knovex_${version}_amd64.deb",
      "packageCategory": "utils",
      "priority": "optional",
      "maintainer": "Gunjan Tailor <tailorgunjan89@gmail.com>",
      "depends": ["libnotify4", "libxtst6", "libnss3"]
    }
  }
}
